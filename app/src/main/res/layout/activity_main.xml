<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="#F5F5F5">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SMS Gateway Settings"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#333333"
                android:layout_marginBottom="30dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="API Configuration"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#666666"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etApiUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="https://example.com/api/sms"
                android:inputType="textUri"
                android:layout_marginBottom="15dp"
                android:padding="12dp"
                android:background="@drawable/edit_text_background"
                android:textColor="#333333"
                android:textColorHint="#999999" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Secret Key"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#666666"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etSecretKey"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter your secret key (min 6 characters)"
                android:inputType="textPassword"
                android:layout_marginBottom="25dp"
                android:padding="12dp"
                android:background="@drawable/edit_text_background"
                android:textColor="#333333"
                android:textColorHint="#999999" />

        </LinearLayout>

    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="10dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="bottom">

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="💾 Save Configuration"
            android:padding="12dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:background="#2196F3"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnViewLogs"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="📋 View SMS Logs"
            android:padding="12dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:background="#4CAF50"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="⚙️ App Settings"
            android:padding="12dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#FF9800"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>
